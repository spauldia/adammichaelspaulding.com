---
import { contact } from "../data/site";
import { profile } from "../data/profile";

const year = new Date().getFullYear();
const github = profile.links.find((link) => link.label === "GitHub");
const linkedin = profile.links.find((link) => link.label === "LinkedIn");
---

<footer class="site-footer" id="contact">
  <div class="footer-inner">
    <h2>{contact.title}</h2>
    <span class="rule" aria-hidden="true"></span>
    <p>{contact.text}</p>
    <div class="footer-actions">
      <a class="button light" href={`mailto:${profile.email}`}>Email</a>
      {linkedin && <a class="button outline-light" href={linkedin.href}>LinkedIn</a>}
      {github && <a class="button outline-light" href={github.href}>GitHub</a>}
    </div>
    <p class="copyright">© {year} {profile.name}</p>
  </div>
</footer>
